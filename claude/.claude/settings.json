{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(go get *)",
      "Bash(go mod *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(gofmt -l .)",
      "Bash(grep -n \"nvm\\\\|NVM\\\\|node\" ~/.zshrc ~/.zshenv ~/.zprofile 2>/dev/null)",
      "Read(//Users/ismith/**)",
      "Bash(docker manifest *)",
      "Bash(git add *)",
      "Bash(git restore *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/hooks/secrets-check.sh",
            "timeout": 15,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 500000,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
